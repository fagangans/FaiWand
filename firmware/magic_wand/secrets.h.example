// secrets.h.example
// Salin file ini menjadi "secrets.h" di folder yang sama, lalu isi nilai asli.
// secrets.h SUDAH di-gitignore — jangan pernah commit isi asli ke git.
#pragma once

#define WIFI_SSID        "NAMA_WIFI_KAMU"
#define WIFI_PASSWORD    "PASSWORD_WIFI_KAMU"

// Alamat server AI lokal (speech-to-speech/speech-to-text) di jaringan yang sama.
// Isi salah satu gaya berikut:
//   - mDNS hostname: "myai.local"  (tidak berubah walau server dapat IP baru dari router)
//   - IP statis:     "192.168.1.50"
#define LOCAL_AI_HOST    "myai.local"
